"""
Standalone reporting add-on for GMS-Poppy.

Run this after the main pipeline has completed, from the same analysis directory:

    snakemake \
        --snakefile path/to/poppy_report/workflow/Snakefile_report \
        --configfile config/config_GRCh38.yaml \
        --configfile config/config_report.yaml \
        --use-singularity \
        -j 4

config_report.yaml holds report-specific settings (non_coding_regions,
synonymous_positions, resource overrides). It can be omitted if those
settings are not needed; all keys have safe defaults.

Prerequisites:
  - Main pipeline must have completed successfully.
  - results/bam/{sample}_{type}.bam files must be present (non-temp).
  - results/vcf/{sample}_{type}.filter.somatic.vcf.gz files must be present.
  - sequenceid is derived automatically from the flowcell column in units.tsv.
"""

__author__ = "Carolina Barros"
__license__ = "GPL-3"

import sys
import pandas
from snakemake.utils import min_version
from hydra_genetics.utils.misc import replace_dict_variables
from hydra_genetics.utils.resources import load_resources

min_version("7.32.0")

if not workflow.overwrite_configfiles:
    sys.exit("At least one config file must be passed using --configfile/--configfiles!")

config = replace_dict_variables(config)
config = load_resources(config, config["resources"])
config = load_resources(config, config["resources_report"])

samples = pandas.read_table(config["samples"], comment="#").set_index("sample", drop=False)
units = (
    pandas.read_table(config["units"], dtype=str, comment="#")
    .set_index(["sample", "type", "flowcell", "lane"], drop=False)
    .sort_index()
)

### Derive sequenceid from units if not explicitly set
if not config.get("sequenceid"):
    flowcells = units["flowcell"].unique().tolist()
    config["sequenceid"] = ",".join(flowcells)


### Wildcard constraints matching main pipeline
wildcard_constraints:
    sample="|".join(samples.index),
    type="N|T|R",


include: "rules/report.smk"


def get_report_outputs():
    """Return results/ paths for all (sample, type) pairs."""
    sample_types = list({(row.sample, row.type) for row in units.itertuples()})
    outputs = [f"results/report/{s}_{t}.xlsx" for s, t in sample_types]
    if config.get("bamsnap", {}).get("enabled", False):
        outputs += [f"results/bamsnap/{s}_{t}/" for s, t in sample_types]
        outputs += [f"results/bamsnap/{s}_{t}.pdf" for s, t in sample_types]
    return outputs


rule all:
    input:
        get_report_outputs(),
